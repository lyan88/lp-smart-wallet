# Salin ke .env lalu isi. Jangan commit .env.

# ---------------------------------------------------------------- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
DRY_RUN=false
# Bahasa alert: en (Inggris), id (Indonesia), atau both (uji tampilan).
ALERT_LANG=id
TELEGRAM_MIN_INTERVAL_SEC=1.2
TELEGRAM_MAX_PER_RUN=4
TELEGRAM_MAX_PER_HOUR=30
TELEGRAM_MAX_PER_DAY=250

# ---------------------------------------------------------------- sumber data
GECKO_NETWORK=solana
# RPC publik gratis sangat dibatasi untuk getTokenLargestAccounts.
# Pakai endpoint gratis dari Helius/QuickNode kalau ingin enumerasi holder LP
# berjalan stabil. Contoh: https://mainnet.helius-rpc.com/?api-key=...
RPC_URL=https://solana-rpc.publicnode.com
RPC_FALLBACKS=https://api.mainnet-beta.solana.com,https://solana.drpc.org
RPC_MIN_INTERVAL=0.12
RPC_TIMEOUT=25
RPC_RETRIES=2
# Anggaran panggilan RPC per proses. Naikkan kalau memakai RPC berbayar.
RPC_BUDGET_PER_RUN=90
GECKO_MIN_INTERVAL=3.5
HTTP_TIMEOUT=25
HTTP_RETRIES=3
USER_AGENT=lp-smart-wallet-finder/1.0 (Solana; read-only research bot)

# ---------------------------------------------------------------- pool
SCAN_PAGES=1
SCAN_POOL_LIMIT=40
MIN_POOL_VOL_USD=100000
MIN_POOL_TVL_USD=20000
MIN_V_TVL=2.0
MAX_POOL_DROP_1H=-25
MAX_POOL_DROP_24H=-60
MIN_POOL_BUYERS_1H=10
DEFAULT_FEE_RATE=0.003
MAX_FEE_YIELD=5.0
LP_MAX_HOLD_DAYS=30

# ---------------------------------------------------------------- trade
TRADE_POOL_LIMIT=5
MIN_TRADE_USD=5
WALLET_MIN_TRADES=2
WALLET_MIN_VOLUME_USD=25
TRADE_LOOKBACK_HOURS=72

# ---------------------------------------------------------------- deteksi LP
LP_POOL_SCAN_LIMIT=2
LP_POOL_TX_SCAN=15
LP_WALLET_ENRICH_LIMIT=6
LP_WALLET_TX_SCAN=5
LP_WALLET_SIG_LIMIT=12
LP_CACHE_HOURS=6
LP_EVENT_LOOKBACK_DAYS=30
MIN_LP_SIZE_USD=200
MIN_LP_TOTAL_SIZE_USD=500

# Alamat yang tidak boleh masuk ranking (pisahkan dengan koma).
IGNORE_ADDRESSES=11111111111111111111111111111111,JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4,6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Wallet yang selalu dipantau. Boleh kosong.
SEED_WALLETS=

# ---------------------------------------------------------------- pemegang LP
# Enumerasi langsung LP token (Raydium CPMM / AMM v4). DEX dengan posisi NFT
# (Orca, Raydium CLMM, Meteora DLMM, PumpSwap) dilewati otomatis.
LP_HOLDER_SCAN_LIMIT=3
LP_HOLDER_CACHE_MIN=20
LP_HOLDER_TOP=20
LP_HOLDER_MIN_PCT=0.001
LP_HOLDER_MIN_USD=500
LP_HOLDER_ALERT_MIN_PCT=0.02
LP_HOLDER_ALERT_MIN_USD=5000
LP_HOLDER_COOLDOWN_HOURS=24

# ---------------------------------------------------------------- skor LP
LP_W_ACTIVITY=0.20
LP_W_QUALITY=0.30
LP_W_EDGE=0.30
LP_W_RECENCY=0.20
LP_TARGET_ADDS=8
LP_EDGE_FULL=0.05

# ---------------------------------------------------------------- skor trading
TRADE_W_WINRATE=0.35
TRADE_W_PEAK=0.30
TRADE_W_ACTIVITY=0.15
TRADE_W_PNL=0.20
TRADE_TARGET_TRADES=20
TRADE_PEAK_FULL=2.0

# Bobot gabungan + tier.
SMART_W_LP=0.70
SMART_W_TRADE=0.30
NO_LP_SCORE_CAP=45
TIER_S=85
TIER_A=70
TIER_B=55
TIER_C=40

# ---------------------------------------------------------------- alert
ALERT_MIN_SCORE=70
ALERT_COOLDOWN_HOURS=24
ALERT_MAX_PER_RUN=3
ALERT_LP_EVENTS=true
ALERT_LP_HOLDERS=true
LP_ALERT_MAX_AGE_HOURS=6
LP_EVENT_COOLDOWN_HOURS=6
ALERT_NEW_WALLET_AFTER_DAYS=7
ALERT_QUEUE_TTL_SEC=1800
ALERT_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- operasional
SCAN_INTERVAL_SEC=300
LOG_KEEP_DAYS=14
SEEN_SIG_KEEP_DAYS=7

# Lokasi database (opsional).
# LSW_DATA_DIR=/var/lib/lp-smart-wallet
# LSW_DB=/var/lib/lp-smart-wallet/lp_smart_wallet.db
